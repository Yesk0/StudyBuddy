DATABASE_URL=postgresql+asyncpg://studybuddy:studybuddy@localhost:5433/studybuddy
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated, e.g. kbtu.kz. Leave empty to accept any email domain.
ALLOWED_EMAIL_DOMAINS=

# Public frontend address, used for links in emails.
APP_URL=http://localhost:5173
# Time zone for session times in reminder emails.
TIMEZONE=Asia/Almaty

# Email. Without SMTP_HOST emails (verification codes, reminders) are printed to the backend log.
# For local development: `docker compose up -d mailpit`, then open http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=StudyBuddy <no-reply@studybuddy.local>

EMAIL_VERIFICATION_REQUIRED=true
REMINDERS_ENABLED=true
